{
  "name": "gastos-iphone",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de gastos personales con captura manual vía Atajos de Apple y captura automática desde notificaciones de Revolut (iOS 27+).",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "gen:env": "tsx scripts/gen-dev-env.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:notifications": "tsx scripts/check-notification-parse.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:unit": "node --env-file-if-exists=.env --import tsx --test \"tests/**/*.test.ts\"",
    "test": "npm run test:unit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "exceljs": "4.4.0",
    "jose": "5.9.6",
    "lucide-react": "0.469.0",
    "next": "^15.5.26",
    "next-themes": "0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "pg": "^8.23.0",
    "prisma": "6.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
