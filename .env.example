# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Desarrollo local (`npm run db:local` levanta PostgreSQL embebido en el 55432):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/gastos"
#
# Producción (cualquier PostgreSQL gestionado: Neon, Supabase, RDS, Railway...):
# DATABASE_URL="postgresql://usuario:password@host:5432/gastos?sslmode=require"

# ---------------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------------
# Segreto para firmar cookies de sesión y derivar hashes de idempotencia.
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres"

# ---------------------------------------------------------------------------
# Atajos de iPhone
# ---------------------------------------------------------------------------
# Secreto del que se deriva el hash de los tokens de dispositivo y de las
# claves de idempotencia. Si rota, los Atajos existentes dejan de funcionar
# (tendrás que volver a crear el token desde la web).
DEVICE_TOKEN_SECRET="otro-secreto-aleatorio-distinto-del-anterior"

# ---------------------------------------------------------------------------
# Revolut
# ---------------------------------------------------------------------------
# NO hay REVOLUT_CLIENT_ID / REVOLUT_CLIENT_SECRET a propósito.
#
# Revolut no ofrece API pública para cuentas personales:
#   "There's no public API for personal Revolut accounts."   (revolut.com)
# La Business API es sólo para cuentas Business del plan Grow o superior, y la
# Open Banking API exige ser proveedor regulado/partner con certificados
# firmados por un QTSP. Ninguna de las dos opciones es aplicable a esta app.
#
# La captura automática se hace, por tanto, con la automatización oficial de
# iOS 27 (Atajos → "Cuando se recibe una notificación"), que es un mecanismo
# del sistema y no de Revolut. Ver docs/INTEGRACIONES.md.
#
# En el futuro, si existiera un proveedor con API oficial, se implementaría la
# interfaz `ExpenseIngestionProvider` de src/lib/integrations/types.ts y se
# añadirían aquí sus credenciales.
